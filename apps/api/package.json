{
  "name": "@shopmecacao/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:core": "node scripts/run-self-test.mjs",
    "test:schema": "node --import tsx src/schemaSelfTest.ts",
    "test:performance": "node scripts/run-self-test.mjs src/performanceSelfTest.ts",
    "test:warehouse": "node scripts/run-self-test.mjs src/warehouseUpgradeSelfTest.ts",
    "test:share": "node scripts/run-self-test.mjs src/inventoryShareSelfTest.ts",
    "test:sales-drafts": "node --import tsx src/salesDraftsSelfTest.ts",
    "test:sales-preview": "node --import tsx src/salesPreviewSelfTest.ts",
    "test:sales-archive": "node --import tsx src/salesArchiveSelfTest.ts",
    "test:sales-staging": "node --import tsx src/salesStagingLabSelfTest.ts",
    "test:restore": "node --import tsx src/losslessRestoreSelfTest.ts",
    "test:sales-preflight": "node --import tsx src/salesPreflightSelfTest.ts",
    "test:sales-commit-lab": "node --import tsx src/salesCommitLabSelfTest.ts",
    "test:sales-confirm-trial": "node --import tsx src/salesConfirmTrialSelfTest.ts",
    "test:sales-execution": "node --import tsx src/salesExecutionSelfTest.ts",
    "test:local-v2-preparation": "node --import tsx src/localV2PreparationSelfTest.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
